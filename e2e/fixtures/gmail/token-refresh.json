    "body": "{\n  \"access_token\": \"ACCESS_TOKEN_PLACEHOLDER\",\n  \"expires_in\": 3599,\n  \"scope\": \"https://www.googleapis.com/auth/gmail.send https://www.googleapis.com/auth/gmail.settings.basic https://www.googleapis.com/auth/userinfo.email openid\",\n  \"token_type\": \"Bearer\",\n  \"id_token\": \"ID_TOKEN_PLACEHOLDER\"\n}"
  }
