#!/usr/bin/env node
// Canned stand-in for the `codex` CLI, beside the fake `claude`. The host runs
// facts extraction, mapping, the Option pick, the draft review and the codex auth probe through
// this binary, so the e2e suite needs no real codex (and no network).
// Contract: `exec ... -o <outFile> <prompt>` — write ONE JSON body to outFile,
// never to stdout (stdout carries a transcript the host must never parse).
//   JFF_FAKE_CODEX_MODE=ok           (default) answer per prompt shape
//   JFF_FAKE_CODEX_MODE=not_authed   exit 1 with a sign-in message on stderr
//   JFF_FAKE_CODEX_MODE=rate_limit   exit 1 with a usage-limit message on stderr
//   JFF_FAKE_CODEX_MODE=timeout      sleep past the host deadline so SIGKILL fires
//   JFF_FAKE_CODEX_HOLD=<path>       (ok mode) hold the MAPPING reply until <path>
//                                    exists; every other call answers at once.
//                                    The test creates the file to release it.
//   JFF_FAKE_CODEX_PICK=<text>       (ok mode) the Option pick answers the position
//                                    of the first Option containing <text>, case
//                                    ignored; unset, it finds none.
//   JFF_FAKE_CODEX_PICK_LOG=<path>   append one line to <path> per Option pick
//                                    prompt, so a test can count the picks the
//                                    stand-in model received.
// Deliberately written to parse identically as CommonJS or ESM: the file has no
// extension, so Node picks the goal symbol itself and this must not care. That
// rules out `require` and a top-level `return`.
const args = process.argv.slice(2)
const prompt = args[args.length - 1] ?? ''
const outFile = args[args.indexOf('-o') + 1] ?? ''
const mode = process.env.JFF_FAKE_CODEX_MODE ?? 'ok'
// Read the claude mode too, so the salary tests keep their contract now that
// mapping has moved off the claude runner.
const claudeMode = process.env.JFF_FAKE_CLAUDE_MODE ?? 'ok'

// Set by body() when the prompt fell through to the mapping branch.
let isMapping = false
// Set by body() to the log file an Option pick is recorded in, if any.
let pickLogged = ''

const body = () => {
  // The codex auth probe from selfCheck.
  if (/Reply with exactly/.test(prompt)) return { ok: true }

  // The review pass: hand the drafted answer back unchanged, so the full-loop
  // suite still asserts the claude draft it always did.
  // The security preamble names the open tag too, so read from the LAST open
  // tag: a match from the first one would hand back the preamble as the draft.
  if (/You review ONE drafted answer/.test(prompt)) {
    const open = '<draft_under_review>'
    const start = prompt.lastIndexOf(open)
    const end = prompt.indexOf('</draft_under_review>', start)
    return { draft: start >= 0 && end > start ? prompt.slice(start + open.length, end) : '' }
  }

  // The Option pick (ADR 0008): the canned model points at the first Option
  // containing JFF_FAKE_CODEX_PICK, and finds none without it. Each pick it
  // receives is logged when JFF_FAKE_CODEX_PICK_LOG names a file.
  if (/You match a stored answer to one of the options/.test(prompt)) {
    const log = process.env.JFF_FAKE_CODEX_PICK_LOG ?? ''
    if (log !== '') pickLogged = log
    const wanted = (process.env.JFF_FAKE_CODEX_PICK ?? '').toLowerCase()
    if (wanted === '') return { position: null }
    for (const m of prompt.matchAll(/^- position=(\d+) <option>([^\n]*)<\/option>$/gm)) {
      if (m[2].toLowerCase().includes(wanted)) return { position: Number(m[1]) }
    }
    return { position: null }
  }

  // Facts extraction: the closed key set, empty is valid.
  if (/You extract job-application facts/.test(prompt)) return {}

  // The mapping call: one entry per ref, in the order the prompt lists them.
  isMapping = true
  const refs = [...prompt.matchAll(/ref=(\d+:\d+)/g)].map((m) => m[1])
  return refs.map((ref) => {
    if (claudeMode === 'salary') {
      const line = prompt.split('\n').find((l) => l.includes(`ref=${ref}`)) ?? ''
      if (/salary|compensation|pretens/i.test(line)) {
        return { ref, decision: 'known_key', knownKey: 'salary', answerId: null }
      }
    }
    // Every Field it matches to nothing is labelled a Prose Field, so the
    // full loop still drafts its free-text question.
    return { ref, decision: 'custom', knownKey: null, answerId: null, fieldClass: 'prose' }
  })
}

if (mode === 'not_authed') {
  process.stderr.write('Error: not logged in\n')
  process.exit(1)
} else if (mode === 'rate_limit') {
  process.stderr.write('usage limit reached\n')
  process.exit(1)
} else if (mode === 'timeout') {
  // Outlive the host's deadline; the host escalates to SIGKILL.
  setTimeout(() => process.exit(0), 130_000)
} else {
  import('node:fs').then((fs) => {
    const answer = JSON.stringify(body())
    if (pickLogged !== '') fs.appendFileSync(pickLogged, 'pick\n', 'utf8')
    const write = () => {
      fs.writeFileSync(outFile, answer, 'utf8')
      process.exit(0)
    }
    const hold = process.env.JFF_FAKE_CODEX_HOLD ?? ''
    if (!isMapping || hold === '') {
      write()
      return
    }
    const poll = setInterval(() => {
      if (!fs.existsSync(hold)) return
      clearInterval(poll)
      write()
    }, 50)
  })
}
